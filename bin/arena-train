#!/usr/bin/env python3
"""The only sanctioned way for an arena agent to train, and the slot it claims.

Agents run in parallel but there is one GPU, so every training run funnels
through an exclusive lock held here for the duration of the run.  The same
critical section **claims a slot** from the cell's fixed budget of training
runs, which makes this file the single point where compute matching is
enforced -- an agent cannot run more experiments than its cell was allotted,
and two agents can never overlap on the card.

The budget is a count of runs, not a stopwatch.  A crash spends a slot exactly
like a successful run does: the cell is allotted N attempts at the GPU, and
wasting one on a bug is a real cost to the group.  That is the point -- error
propagation is one of the things under study, and it is invisible if crashes
are free.  Seconds are still recorded, as telemetry.

The slot is claimed *before* training starts, so a cell can never overshoot
its budget even if the orchestrator's own accounting lags.

Under the **open protocol** (``$ARENA_PROTOCOL=open``) there is no orchestrator
phase around a run, so this command also does what the round loop would have
done: it commits ``train.py`` before training (the commit hash is the
reproduction pointer for the finding you will publish), records the result in
the shared directory's score log afterwards, archives ``run.log`` and enforces
the per-agent share of the budget.  ``arena-train --title "what this attempt
changes"`` is how the score log knows what a line means.

Exit codes:
    0  training completed (the run may still have crashed on its own merits)
    2  no slots left -- the cell's budget, or your share of it, is spent
    3  the run exceeded the wall-clock timeout and was killed
    4  called outside the select phase (round protocol only)
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import random
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

NOMINAL_RUN_SECONDS = 330.0


def env(name: str, default: str | None = None) -> str:
    value = os.environ.get(name, default)
    if value is None:
        sys.exit(f"arena-train: ${name} is not set (are you inside an arena worktree?)")
    return value


def claim_slot(budget_path: Path, agent: str, round_idx: str, quota: int) -> dict | str:
    """Take one run slot; return "cell" or "quota" when nothing is left.

    Caller must hold the GPU lock: this is a read-modify-write, and the whole
    point is that two agents cannot claim the last slot at once.
    """
    state = json.loads(budget_path.read_text())
    if state.get("runs", 0) >= state["budget_runs"]:
        return "cell"
    if quota and sum(1 for c in state.get("claims", []) if c.get("agent") == agent) >= quota:
        return "quota"
    state["runs"] = state.get("runs", 0) + 1
    state.setdefault("claims", []).append(
        {"run": state["runs"], "agent": agent, "round": int(round_idx), "at": time.time()}
    )
    budget_path.write_text(json.dumps(state, indent=2))
    return state


def record_seconds(budget_path: Path, amount: float) -> dict:
    """Telemetry only -- the budget is runs, not seconds."""
    state = json.loads(budget_path.read_text())
    state["spent_s"] = state.get("spent_s", 0.0) + amount
    budget_path.write_text(json.dumps(state, indent=2))
    return state


def simulate(run_dir: Path, round_idx: str, agent: str, variant: str, seed: str) -> tuple[str, float]:
    """Fake-GPU mode: a plausible run.log without an H100.

    Deterministic in (seed, round, agent, variant) *and in the contents of
    train.py*.  Keying on the file matters: without it the score is unrelated
    to what the agent changed, so an agent that reads its own run.log
    correctly concludes the substrate is broken and spends the rest of the
    cell saying so.  Hashing the source does not make the number meaningful,
    but it does make it consistent -- the same edit always scores the same,
    and a different edit scores differently.
    """
    train_py = Path.cwd() / "train.py"
    src = train_py.read_bytes() if train_py.exists() else b""
    key = f"{seed}:{round_idx}:{agent}:{variant}:".encode() + hashlib.sha256(src).digest()
    rng = random.Random(int(hashlib.sha256(key).hexdigest()[:16], 16))

    base = float(os.environ.get("ARENA_FAKE_BASE_BPB", "0.997900"))
    time.sleep(rng.uniform(2.0, 5.0))  # short, but long enough to expose races

    if rng.random() < 0.12:  # crashes are part of the phenomenon under study
        return (
            "Traceback (most recent call last):\n"
            '  File "train.py", line 412, in <module>\n'
            "    loss.backward()\n"
            "torch.OutOfMemoryError: CUDA out of memory (simulated)\n"
        ), rng.uniform(15.0, 45.0)

    val_bpb = max(0.5, base + rng.gauss(-0.0015, 0.004))
    log = (
        "---\n"
        f"val_bpb:          {val_bpb:.6f}\n"
        "training_seconds: 300.1\n"
        "total_seconds:    325.9\n"
        f"peak_vram_mb:     {rng.uniform(40000, 48000):.1f}\n"
        "mfu_percent:      39.80\n"
        "total_tokens_M:   499.6\n"
        "num_steps:        953\n"
        "num_params_M:     50.3\n"
        "depth:            8\n"
    )
    return log, NOMINAL_RUN_SECONDS


def git(*args: str, check: bool = False) -> str:
    proc = subprocess.run(["git", *args], capture_output=True, text=True)
    if check and proc.returncode != 0:
        raise RuntimeError(proc.stderr.strip())
    return proc.stdout.strip()


def open_commit(agent: str, title: str) -> str:
    """Open protocol: pin the code that is about to be measured."""
    if git("status", "--porcelain", "--", "train.py"):
        git("add", "train.py")
        git("-c", "user.name=arena", "-c", "user.email=arena@local", "commit", "-qm",
            f"[{agent}] {title[:72] or 'attempt'}")
    return git("rev-parse", "HEAD")


def open_record(run_dir: Path, agent: str, seq: int, commit: str, title: str,
                log_path: Path, workdir: Path, charged_s: float) -> None:
    """Open protocol: the score-log line, the archive and the re-rendered view."""
    from orchestrator.gpu import parse_run_log
    from orchestrator.sharedlog import SharedLog, append_record

    m = parse_run_log(log_path)
    append_record(
        run_dir / "log.jsonl", "candidate",
        round=seq, agent=agent, variant=0, commit=commit,
        val_bpb=m.val_bpb, peak_vram_mb=m.peak_vram_mb,
        status="ok" if m.ok else "crash",
        title=title, description=title, reflection="",
        error=(m.error or "")[:2000], attempts=1, cost_usd=0.0, num_turns=0,
        charged_s=round(charged_s, 2), source="arena-train",
    )
    tag = os.environ.get("ARENA_TAG", "open")
    git("update-ref", f"refs/arena/{tag}/open_{agent}_{seq:03d}", commit)
    dest = run_dir / "runs" / agent / f"run{seq:03d}"
    dest.mkdir(parents=True, exist_ok=True)
    for name in ("run.log", "train.py"):
        if (workdir / name).exists():
            shutil.copy2(workdir / name, dest / name)
    share = os.environ.get("ARENA_SHARE_LOG", "1") == "1"
    agents = [a for a in os.environ.get("ARENA_AGENTS", "").split(",") if a]
    SharedLog(run_dir).publish_open(share=share, agents=agents or None)


def main() -> int:
    ap = argparse.ArgumentParser(prog="arena-train", add_help=True)
    ap.add_argument("--title", default="", help="open protocol: what this attempt changes (one line)")
    args = ap.parse_args()

    # Run the real work in a detached worker (its own session). If the agent's shell command that
    # invoked us is killed, by a tool timeout or a capped session, the worker still finishes the
    # run, releases the GPU lock and writes the record; the agent can read the result from the log.
    if os.environ.get("ARENA_DETACHED") != "1":
        out_path = Path.cwd() / "arena-train.out"
        env_child = dict(os.environ, ARENA_DETACHED="1")
        with open(out_path, "w") as out:
            child = subprocess.Popen([sys.executable, os.path.abspath(__file__), *sys.argv[1:]],
                                     stdout=out, stderr=subprocess.STDOUT, env=env_child,
                                     start_new_session=True)
        try:
            rc = child.wait()
        except KeyboardInterrupt:
            rc = child.wait()
        sys.stdout.write(out_path.read_text(errors="replace"))
        sys.stdout.flush()
        return rc

    run_dir = Path(env("ARENA_RUN_DIR")).resolve()
    agent = env("ARENA_AGENT")
    variant = env("ARENA_VARIANT", "0")
    round_idx = env("ARENA_ROUND", "0")
    timeout_s = float(env("ARENA_TIMEOUT_S", "600"))
    fake = env("ARENA_FAKE_GPU", "0") == "1"
    seed = env("ARENA_SEED", "0")
    protocol = env("ARENA_PROTOCOL", "rounds")
    quota = int(env("ARENA_AGENT_QUOTA", "0") or 0)

    # Slots are claimed in the select phase.  Training during propose or
    # respond would spend the group's budget outside the protocol and make the
    # round's candidate set not mean what the log says it means.
    phase = env("ARENA_PHASE", "select")
    if phase not in ("select", "open"):
        print(
            f"arena-train: this is the {phase} phase, not select. You cannot claim a "
            "run slot here. Say what you want to say and finish the phase.",
            file=sys.stderr,
        )
        return 4

    lock_path = run_dir / "gpu.lock"
    budget_path = run_dir / "budget.json"
    timeline_path = run_dir / "gpu_timeline.jsonl"
    workdir = Path.cwd()
    log_path = workdir / "run.log"

    commit = ""
    if protocol == "open":
        commit = open_commit(agent, args.title)

    lock_path.touch(exist_ok=True)
    lock_file = open(lock_path, "w")

    waiting_since = time.time()
    print("arena-train: waiting for the GPU ...", flush=True)
    fcntl.flock(lock_file, fcntl.LOCK_EX)
    queued_s = time.time() - waiting_since

    try:
        claimed = claim_slot(budget_path, agent, round_idx, quota)
        if claimed == "cell":
            print(
                "arena-train: the cell's training-run budget is exhausted; there are "
                "no slots left. Stop experimenting, commit what you have, write "
                "candidate.json with status \"abandoned\", and finish.",
                file=sys.stderr,
            )
            return 2
        if claimed == "quota":
            print(
                f"arena-train: your share of the budget ({quota} runs) is spent. You cannot "
                "train again in this cell. Publish your final finding (arena-log finding ...), "
                "write final.json, and finish.",
                file=sys.stderr,
            )
            return 2

        seq = claimed["runs"]
        remaining = claimed["budget_runs"] - seq
        mine = sum(1 for c in claimed.get("claims", []) if c.get("agent") == agent)
        share_note = f"; your share: {quota - mine} of {quota} left" if quota else ""
        print(f"arena-train: GPU acquired (waited {queued_s:.0f}s; claimed run "
              f"{seq} of {claimed['budget_runs']}, {remaining} left "
              f"for the whole cell{share_note})", flush=True)

        started = time.time()
        timed_out = False

        if fake:
            log_text, charge_s = simulate(run_dir, str(seq) if protocol == "open" else round_idx,
                                          agent, variant, seed)
            log_path.write_text(log_text)
            exit_code = 0
        else:
            child_env = dict(os.environ)
            # All worktrees share one venv: deps are frozen by the rules, and
            # re-resolving per worktree would burn minutes of every round.
            child_env.setdefault("UV_PROJECT_ENVIRONMENT", env("ARENA_UV_ENV", ""))
            with open(log_path, "w") as log_file:
                proc = subprocess.Popen(
                    ["uv", "run", "train.py"],
                    stdout=log_file,
                    stderr=subprocess.STDOUT,
                    cwd=workdir,
                    env=child_env,
                    start_new_session=True,
                )
                try:
                    exit_code = proc.wait(timeout=timeout_s)
                except subprocess.TimeoutExpired:
                    timed_out = True
                    os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
                    proc.wait()
                    exit_code = -9
            charge_s = time.time() - started

        elapsed = time.time() - started
        state = record_seconds(budget_path, charge_s)

        # A crashed run can still exit 0, so the metric is the real signal.
        produced_metric = any(
            line.startswith("val_bpb:")
            for line in log_path.read_text(errors="replace").splitlines()
        )

        record = {
            "round": seq if protocol == "open" else int(round_idx),
            "agent": agent,
            "variant": int(variant),
            "workdir": str(workdir),
            "started_at": started,
            "ended_at": time.time(),
            "elapsed_s": round(elapsed, 2),
            "charged_s": round(charge_s, 2),
            "queued_s": round(queued_s, 2),
            "exit_code": exit_code,
            "produced_metric": produced_metric,
            "timed_out": timed_out,
            "fake": fake,
            "spent_s_after": round(state["spent_s"], 2),
            "runs_after": state["runs"],
            "commit": commit,
        }
        with open(timeline_path, "a") as fh:
            fh.write(json.dumps(record) + "\n")
        (workdir / "arena_run.json").write_text(json.dumps(record, indent=2))

        if protocol == "open":
            open_record(run_dir, agent, seq, commit, args.title, log_path, workdir, charge_s)

    finally:
        fcntl.flock(lock_file, fcntl.LOCK_UN)
        lock_file.close()

    if timed_out:
        print(
            f"arena-train: killed after {timeout_s:.0f}s. Treat this as a failed "
            "experiment and revert it.",
            file=sys.stderr,
        )
        return 3

    # Echo the summary so the agent can read the metric without cat-ing the log.
    for line in log_path.read_text().splitlines():
        if line.startswith(("val_bpb:", "peak_vram_mb:", "training_seconds:")):
            print(line)
    if protocol == "open":
        print(f"arena-train: result recorded in the score log as run #{seq}, commit {commit[:7]}")
    print(f"arena-train: done in {elapsed:.0f}s (exit {exit_code})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
